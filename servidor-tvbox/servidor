#!/usr/bin/env bash
# Comando de ajuda do servidor da TV Box. Digite "servidor" no terminal (do Cockpit ou SSH).
set -uo pipefail

DIR=/opt/servidor
RAW="${RAW:-https://raw.githubusercontent.com/zael20/painel-mes-tfleet-bdv/main/servidor-tvbox}"
DC="docker compose -f $DIR/docker-compose.yml --project-directory $DIR"

ok()   { echo -e "\e[32m[OK]\e[0m $*"; }
aviso(){ echo -e "\e[33m[!]\e[0m $*"; }
root() { [ "$(id -u)" -eq 0 ] || { echo "Use com sudo:  sudo servidor $*"; exit 1; }; }

# onibus TFLEET + resumo em todo terminal que abrir (Central, Alt+F2, SSH); cache atualizado a cada 5 min
instalar_boas_vindas() {
  cat > /etc/profile.d/zz-servidor-boas-vindas.sh <<'SH'
# boas-vindas do servidor da TV Box (servidor boas-vindas). Para tirar: apague este arquivo.
case $- in *i*) [ -t 1 ] && [ -x /usr/local/bin/servidor ] && /usr/local/bin/servidor boas-vindas 2>/dev/null ;; esac
SH
  echo '*/5 * * * * root /usr/local/bin/servidor estado-cache >/dev/null 2>&1' > /etc/cron.d/servidor-estado
  echo '@reboot root sleep 90; /usr/local/bin/servidor estado-cache >/dev/null 2>&1' >> /etc/cron.d/servidor-estado
  /usr/local/bin/servidor estado-cache >/dev/null 2>&1 &
}

ajuda() {
cat <<TXT
servidor status            -> o que esta rodando, memoria, disco e temperatura
servidor logs [servico]    -> ultimas linhas de log (n8n, evolution, postgres, redis)
servidor reiniciar [serv]  -> reinicia tudo ou um servico
servidor backup            -> salva fluxos + credenciais agora (em $DIR/backups)
servidor importar          -> importa os .json colocados em $DIR/importar para o n8n
servidor atualizar [n8n=X] [evolution=Y] -> troca a versao (com backup antes) e reinicia
servidor versoes           -> mostra as versoes em uso
servidor atualizar-script  -> atualiza este comando a partir do GitHub
servidor whatsapp          -> liga o fluxo de ocorrencias (Supabase, Gemini, grupo)
servidor retroativo [dias] -> importa o historico do grupo (.txt exportado) para o Supabase
servidor acessos           -> mostra os enderecos e a chave da Evolution
servidor tela              -> resumo do servidor numa tela so (o mesmo da tela HDMI)
servidor tela-ligar        -> mostra esse resumo sozinho na TV ligada no HDMI (login fica no Alt+F2)
servidor tela-desligar     -> volta a tela HDMI para o login normal
servidor boas-vindas       -> onibus TFLEET + resumo curto (aparece sozinho ao abrir um terminal)
TXT
}

case "${1:-}" in
  status)
    $DC ps --format 'table {{.Service}}\t{{.Status}}'
    echo; free -h | head -2
    echo; df -h / | tail -1 | awk '{print "Cartao SD: "$3" usados de "$2" ("$5")"}'
    t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0); echo "Temperatura: $((t/1000)) C"
    echo "Tailscale: $(tailscale ip -4 2>/dev/null | head -1 || echo 'desligado')"
    echo "Ultimo backup: $(ls -1t $DIR/backups/*.tar.gz 2>/dev/null | head -1 || echo 'nenhum ainda')"
    ;;
  logs)       $DC logs --tail "${3:-60}" ${2:-} ;;
  reiniciar)  root "$@"; $DC restart ${2:-}; ok "Reiniciado" ;;
  backup)
    root "$@"
    d=$(date +%Y-%m-%d_%H%M); tmp="$DIR/backups/$d"
    mkdir -p "$tmp/fluxos" && chown -R 1000:1000 "$DIR/backups"
    $DC exec -T n8n n8n export:workflow --all --backup --output=/backups/$d/fluxos/ >/dev/null \
      && $DC exec -T n8n n8n export:credentials --all --backup --output=/backups/$d/credenciais/ >/dev/null \
      || { aviso "Falhou exportar do n8n"; exit 1; }
    cp "$DIR/segredos.env" "$DIR/.env" "$tmp/" 2>/dev/null; [ -f "$DIR/config.env" ] && cp "$DIR/config.env" "$tmp/"
    tar -czf "$DIR/backups/backup-$d.tar.gz" -C "$DIR/backups" "$d" && rm -rf "$tmp"
    chmod 600 "$DIR/backups/backup-$d.tar.gz"
    find "$DIR/backups" -name 'backup-*.tar.gz' -mtime +14 -delete
    ok "Backup: $DIR/backups/backup-$d.tar.gz (credenciais seguem criptografadas; a chave esta no segredos.env do mesmo arquivo)"
    ;;
  importar)
    root "$@"
    ls "$DIR"/importar/*.json >/dev/null 2>&1 || { echo "Coloque os .json em $DIR/importar e rode de novo."; exit 1; }
    chown -R 1000:1000 "$DIR/importar"
    for f in "$DIR"/importar/*.json; do
      b=$(basename "$f")
      if $DC exec -T n8n n8n import:workflow --input="/importar/$b"; then ok "Importado: $b"; mv "$f" "$f.importado"; else aviso "Falhou: $b"; fi
    done
    echo "Abra o n8n, confira as credenciais de cada fluxo e ligue o botao Publish/Active."
    ;;
  atualizar)
    # uso: servidor atualizar [n8n=2.46.0] [evolution=v2.3.8]   (sem versao: so baixa correcoes da mesma versao)
    # as versoes ficam fixas no .env de proposito: nada muda sozinho de madrugada e quebra um fluxo
    root "$@"
    "$0" backup
    for a in "${@:2}"; do
      case "$a" in
        n8n=*)       sed -i "s/^N8N_TAG=.*/N8N_TAG=${a#n8n=}/" "$DIR/.env"; ok "n8n -> ${a#n8n=}" ;;
        evolution=*) sed -i "s/^EVOLUTION_TAG=.*/EVOLUTION_TAG=${a#evolution=}/" "$DIR/.env"; ok "Evolution -> ${a#evolution=}" ;;
        *) aviso "Ignorado: $a (use n8n=VERSAO ou evolution=VERSAO)" ;;
      esac
    done
    grep -E '^(N8N_TAG|EVOLUTION_TAG)=' "$DIR/.env"
    $DC pull -q && $DC up -d && ok "Atualizado. Se algo quebrar, me chame: o backup de agora esta em $DIR/backups"
    ;;
  versoes)
    grep -E '^(N8N_TAG|EVOLUTION_TAG)=' "$DIR/.env" 2>/dev/null || sudo grep -E '^(N8N_TAG|EVOLUTION_TAG)=' "$DIR/.env"
    ;;
  atualizar-script)
    root "$@"
    curl -fsSL "$RAW/servidor" -o /usr/local/bin/servidor.novo && mv /usr/local/bin/servidor.novo /usr/local/bin/servidor \
      && chmod 755 /usr/local/bin/servidor && ok "Comando atualizado"
    curl -fsSL "$RAW/configurar-whatsapp.sh" -o "$DIR/configurar-whatsapp.sh" && ok "configurar-whatsapp.sh atualizado"
    curl -fsSL "$RAW/whatsapp-retroativo.py" -o "$DIR/whatsapp-retroativo.py" && ok "whatsapp-retroativo.py atualizado"
    mkdir -p /usr/share/cockpit/central/vendor
    for f in manifest.json index.html central.css central.js vendor/xterm.js vendor/xterm.css vendor/addon-fit.js; do
      curl -fsSL "$RAW/central/$f" -o "/usr/share/cockpit/central/$f.novo" && mv "/usr/share/cockpit/central/$f.novo" "/usr/share/cockpit/central/$f"
    done && ok "Central da Frota atualizada (recarregue a pagina)"
    instalar_boas_vindas && ok "Boas-vindas (onibus TFLEET) ligada (aparece ao abrir um terminal)"
    ;;
  # ---- usados pela Central da Frota (interface no Cockpit); respondem em JSON
  status-json)
    root "$@"
    export SV_PS=$($DC ps -a --format '{{.Service}}|{{.State}}|{{.Status}}' 2>/dev/null)
    export SV_TS=$(tailscale ip -4 2>/dev/null | head -1)
    export SV_BK=$(ls -1t $DIR/backups/*.tar.gz 2>/dev/null | head -1)
    export SV_TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)
    export SV_LAN=$(hostname -I | awk '{print $1}')
    python3 - <<'PY'
import json, os, shutil
mem = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo')}
du = shutil.disk_usage('/')
svc = [dict(zip(['nome', 'estado', 'detalhe'], l.split('|'))) for l in os.environ['SV_PS'].splitlines() if l]
print(json.dumps({
  'servicos': svc,
  'ram_total_mb': mem['MemTotal'] // 1024, 'ram_livre_mb': mem['MemAvailable'] // 1024,
  'disco_total_gb': round(du.total / 1e9, 1), 'disco_usado_gb': round(du.used / 1e9, 1),
  'temp_c': int(os.environ['SV_TEMP'] or 0) // 1000,
  'ip_casa': os.environ['SV_LAN'], 'ip_tailscale': os.environ['SV_TS'],
  'ultimo_backup': os.path.basename(os.environ['SV_BK']) if os.environ['SV_BK'] else ''}))
PY
    ;;
  fluxos-json)
    root "$@"
    # le direto do banco do n8n (rapido); se falhar, usa o CLI do n8n (lento numa TV Box)
    export SV_DB="$(docker volume inspect -f '{{.Mountpoint}}' servidor_n8n_data 2>/dev/null)/database.sqlite"
    python3 - 2>/dev/null <<'PY' && exit 0
import json, os, sqlite3
c = sqlite3.connect(f"file:{os.environ['SV_DB']}?mode=ro", uri=True)
rows = c.execute("select id, name, activeVersionId is not null from workflow_entity where coalesce(isArchived, 0) = 0").fetchall()
print(json.dumps(sorted([{'id': r[0], 'nome': r[1], 'ativo': bool(r[2])} for r in rows], key=lambda f: f['nome'].lower())))
PY
    export SV_ALL=$($DC exec -T n8n n8n list:workflow 2>/dev/null)
    export SV_ON=$($DC exec -T n8n n8n list:workflow --active=true 2>/dev/null)
    python3 - <<'PY'
import json, os
on = {l.split('|')[0] for l in os.environ['SV_ON'].splitlines() if '|' in l}
fl = [{'id': l.split('|', 1)[0], 'nome': l.split('|', 1)[1], 'ativo': l.split('|')[0] in on}
      for l in os.environ['SV_ALL'].splitlines() if '|' in l]
print(json.dumps(sorted(fl, key=lambda f: f['nome'].lower())))
PY
    ;;
  whatsapp-json)
    root "$@"
    set -a; source "$DIR/segredos.env"; source "$DIR/.env"; set +a
    curl -s --max-time 8 http://127.0.0.1:8080/instance/fetchInstances -H "apikey: $EVO_API_KEY" | python3 -c "
import sys, json, os
esperado = os.environ.get('WHATSAPP_NUMERO', '')
try: d = json.load(sys.stdin)
except Exception: print(json.dumps({'ok': False, 'esperado': esperado, 'instancias': []})); raise SystemExit
d = d if isinstance(d, list) else d.get('response', [])
print(json.dumps({'ok': True, 'esperado': esperado, 'instancias': [{'nome': i.get('name'), 'estado': i.get('connectionStatus'), 'numero': (i.get('ownerJid') or '').split('@')[0]} for i in d]}))"
    ;;
  fluxo-ligar|fluxo-desligar)
    root "$@"
    [ -n "${2:-}" ] || { echo "Informe o id do fluxo"; exit 1; }
    a=true; [ "$1" = fluxo-desligar ] && a=false
    if [ "$a" = true ]; then
      $DC exec -T n8n sh -c "n8n publish:workflow --id=$2 2>/dev/null || n8n update:workflow --id=$2 --active=true"
    else
      $DC exec -T n8n sh -c "n8n unpublish:workflow --id=$2 2>/dev/null || n8n update:workflow --id=$2 --active=false"
    fi
    $DC restart n8n >/dev/null && ok "Fluxo $2: ativo=$a (n8n reiniciado)"
    ;;
  fluxo-exportar)
    root "$@"
    [ -n "${2:-}" ] || { echo "Informe o id do fluxo"; exit 1; }
    # le direto do banco do n8n (1 segundo); se falhar, usa o CLI do n8n (pode passar de 1 minuto na TV Box)
    export SV_DB="$(docker volume inspect -f '{{.Mountpoint}}' servidor_n8n_data 2>/dev/null)/database.sqlite"
    python3 - "$2" 2>/dev/null <<'PY' && exit 0
import json, os, sqlite3, sys
c = sqlite3.connect(f"file:{os.environ['SV_DB']}?mode=ro", uri=True)
c.row_factory = sqlite3.Row
r = c.execute("select * from workflow_entity where id = ?", (sys.argv[1],)).fetchone()
if r is None: sys.exit(1)
r = dict(r)
wf = {"id": r["id"], "name": r["name"], "active": False}
for k in ("nodes", "connections", "settings", "staticData", "pinData", "meta"):
    v = r.get(k)
    if isinstance(v, str):
        try: v = json.loads(v)
        except ValueError: pass
    if v is not None: wf[k] = v
if not isinstance(wf.get("nodes"), list): sys.exit(1)
print(json.dumps([wf], ensure_ascii=False))
PY
    chown -R 1000:1000 "$DIR/importar"
    $DC exec -T n8n n8n export:workflow --id="$2" --output="/importar/.exportado-$2.json" >/dev/null 2>&1 \
      || { echo "Falhou exportar o fluxo $2" >&2; exit 1; }
    cat "$DIR/importar/.exportado-$2.json"; rm -f "$DIR/importar/.exportado-$2.json"
    ;;
  fluxo-salvar)
    # a Central grava o fluxo editado em importar/.editar-<id>.json; aqui ele substitui o do n8n
    root "$@"
    id="${2:-}"; f="$DIR/importar/.editar-$id.json"
    [ -n "$id" ] && [ -f "$f" ] || { echo "Arquivo do fluxo editado nao encontrado"; exit 1; }
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" || { echo "JSON invalido, nada foi alterado"; exit 1; }
    "$0" backup >/dev/null && ok "Backup feito antes de alterar"
    ativo=$("$0" fluxos-json | python3 -c "import json,sys; print(any(f['id']==sys.argv[1] and f['ativo'] for f in json.load(sys.stdin)))" "$id")
    chown 1000:1000 "$f"
    $DC exec -T n8n n8n import:workflow --input="/importar/.editar-$id.json" || { aviso "Falhou importar"; exit 1; }
    rm -f "$f"
    if [ "$ativo" = True ]; then
      $DC exec -T n8n sh -c "n8n publish:workflow --id=$id 2>/dev/null || n8n update:workflow --id=$id --active=true" >/dev/null
    fi
    $DC restart n8n >/dev/null && ok "Fluxo salvo$( [ "$ativo" = True ] && echo ' e religado'). O n8n reiniciou (1 a 2 minutos para voltar)."
    ;;
  rede-json)
    root "$@"
    export SV_CABO=$(ip -br -4 addr show 2>/dev/null | grep -E '^(e|end)' | head -1)
    export SV_NET=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 https://www.google.com)
    export SV_TS=$(tailscale status --json 2>/dev/null || echo '{}')
    export SV_WIFI=$(command -v nmcli >/dev/null && nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | grep '^wifi' | head -1 || echo SEM)
    export SV_BT=$(command -v bluetoothctl >/dev/null && timeout 5 bluetoothctl show 2>&1 || echo SEM)
    python3 - <<'PY'
import json, os, re
cabo = os.environ['SV_CABO'].split()
ts = json.loads(os.environ['SV_TS'] or '{}')
wifi = os.environ['SV_WIFI'].strip()
bt = os.environ['SV_BT']
wp = re.split(r'(?<!\\):', wifi) if wifi and wifi != 'SEM' else []
print(json.dumps({
  'cabo': {'ok': len(cabo) > 1 and cabo[1] == 'UP', 'nome': cabo[0] if cabo else '', 'ip': cabo[2] if len(cabo) > 2 else ''},
  'internet': {'ok': os.environ['SV_NET'][:1] in ('2', '3')},
  'tailscale': {'ok': ts.get('BackendState') == 'Running', 'estado': ts.get('BackendState', 'desligado'),
                'ip': (ts.get('TailscaleIPs') or [''])[0], 'login': ts.get('AuthURL', '')},
  'wifi': {'existe': bool(wp), 'ligado': bool(wp) and wp[1] not in ('unavailable',), 'conectado': bool(wp) and wp[1] == 'connected',
           'rede': wp[2].replace('\\:', ':') if len(wp) > 2 else ''},
  'bluetooth': {'existe': 'Controller' in bt and 'No default controller' not in bt, 'ligado': 'Powered: yes' in bt}}))
PY
    ;;
  tailscale-ligar)
    root "$@"
    tailscale up --hostname=servidor-frota --timeout=8s 2>&1 | grep -o 'https://login.tailscale.com[^ ]*' | head -1 || true
    tailscale status --json 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('AuthURL',''))" 2>/dev/null | grep . || true
    ;;
  whatsapp)   root "$@"; DIR=$DIR bash "$DIR/configurar-whatsapp.sh" ;;
  retroativo)
    # uso: servidor retroativo [dias]  -> le o .txt da conversa exportada em importar/ e grava o historico no Supabase
    root "$@"
    [ -f "$DIR/config.env" ] || { echo "Configure o WhatsApp antes:  sudo servidor whatsapp"; exit 1; }
    [ -f "$DIR/whatsapp-retroativo.py" ] || curl -fsSL "$RAW/whatsapp-retroativo.py" -o "$DIR/whatsapp-retroativo.py"
    ( set -a; source "$DIR/config.env"; set +a; DIR=$DIR python3 "$DIR/whatsapp-retroativo.py" "${2:-60}" )
    ;;
  acessos)    root "$@"; cat "$DIR/ACESSOS.txt" ;;
  estado-cache)
    # junta Docker/fluxos/WhatsApp/rede num arquivo que qualquer terminal le sem sudo (boas-vindas)
    root "$@"
    mkdir -p /run/servidor
    export SV_ST="$("$0" status-json 2>/dev/null)" SV_FL="$("$0" fluxos-json 2>/dev/null)" SV_WA="$("$0" whatsapp-json 2>/dev/null)"
    export SV_NET="$(curl -s -o /dev/null -m 6 -w '%{http_code}' https://www.google.com 2>/dev/null)"
    export SV_CABO="$(cat /sys/class/net/e*/operstate 2>/dev/null | head -1)"
    python3 - <<'PY'
import json, os, time
def lj(k, padrao):
    try: return json.loads(os.environ.get(k) or "")
    except ValueError: return padrao
dados = {"ts": time.time(), "st": lj("SV_ST", {}), "fl": lj("SV_FL", []), "wa": lj("SV_WA", {}),
         "net": (os.environ.get("SV_NET") or "")[:1] in ("2", "3"), "cabo": os.environ.get("SV_CABO") == "up"}
with open("/run/servidor/estado.json.tmp", "w") as f: json.dump(dados, f)
os.chmod("/run/servidor/estado.json.tmp", 0o644)
os.replace("/run/servidor/estado.json.tmp", "/run/servidor/estado.json")
PY
    ;;
  tela|boas-vindas)
    # onibus TFLEET + resumo (estilo neofetch). "tela" = completo (TV do HDMI); "boas-vindas" = ao abrir um terminal
    if [ "$1" = tela ] && [ "$(id -u)" -eq 0 ]; then "$0" estado-cache >/dev/null 2>&1; fi
    SV_MODO="$1" python3 - <<'PY'
import json, os, time, shutil, socket, getpass
N, B = "\033[0m", "\033[1m"
V, R, A, C, CI = "\033[32m", "\033[31m", "\033[33m", "\033[36m", "\033[90m"
MODO = os.environ.get("SV_MODO", "tela")
try:
    e = json.load(open("/run/servidor/estado.json"))
except (OSError, ValueError):
    e = {}
idade_min = int((time.time() - e.get("ts", 0)) / 60) if e else None
st, fl, wa = e.get("st") or {}, e.get("fl") or [], e.get("wa") or {}

# ---- onibus da frota em caracteres (passageiros e frase mudam a cada vez) ----
import random, re
Y, G, CY, W, CI, R, N = "\033[33;1m", "\033[32;1m", "\033[36;1m", "\033[97;1m", "\033[90m", "\033[31;1m", "\033[0m"
CARAS = ["^_^", "-_-", "o.o", "^o^", ">_<", "*_*", "u_u", "O_O", "z_z", "^.^", "@_@", "T_T", "°o°"]
FRASES = ["Bluetooth ligado, motorista?", "Proxima parada: Paragominas!", "Cinto afivelado, por favor!",
          "Passageiro sem leitura? Olha o BT!", "Roteador desligado, ne? ;)", "Rumo a Hydro, sem atraso!",
          "Carregador no lugar? Entao bora!", "Celular lendo, viagem contando!"]
k = random.sample(CARAS, 5)
jan = "".join(f"{CY}|{W}{c}{CY}|" for c in k)
ARTE = [
 f"     {Y}_______________________________{N}",
 f"    {Y}|{CY} ___  ___  ___  ___  ___  {Y}|{CY}  _ {Y} \\{N}",
 f"    {Y}|{jan} {Y}|{CY} | |{Y}  \\{N}",
 f"    {Y}|{CY}|___||___||___||___||___| {Y}|{CY} | |{Y}____\\_{N}",
 f"    {Y}|                          |{CY} |_|{Y}     |{N}",
 f" {CI}°o {Y}|   {G}T F L E E T{Y}   {R}M E S{Y}    |      {W}[]{Y} |{N}",
 f"{CI}o°.{N} {Y}|____/ {W}(){Y} \\__________/ {W}(){Y} \\__________|{N}",
 f"          {W}\\__/{N}            {W}\\__/{N}",
 f"{CI}=============================================={N}",
]
FRASE = random.choice(FRASES)
ARTE.append(f"   {Y}\"{FRASE}\"{N}")
LARG = 46
logo = ARTE
logo_larg = [len(re.sub(r"\033\[[0-9;]*m", "", l)) for l in ARTE]

# ---- informacoes (as locais sao lidas na hora; Docker/fluxos/WhatsApp vem do cache do root) ----
mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
livre, total = mem.get("MemAvailable", 0) // 1024, mem.get("MemTotal", 0) // 1024
du = shutil.disk_usage("/")
try: temp = int(open("/sys/class/thermal/thermal_zone0/temp").read()) // 1000
except (OSError, ValueError): temp = 0
up = int(float(open("/proc/uptime").read().split()[0]))
dias, resto = divmod(up, 86400)
ligado = (f"{dias} d " if dias else "") + f"{resto // 3600} h {resto % 3600 // 60} min"
sq = lambda bom: (V if bom else R) + "■" + N
rotulo = lambda t: C + B + f"{t:<10}" + N
info = [f"{V}{B}{getpass.getuser()}{N}@{V}{B}{socket.gethostname()}{N}", CI + "─" * 34 + N,
        f"{B}Bem-vindo, Mizael!{N}",
        rotulo("Data") + time.strftime("%d/%m/%Y %H:%M"),
        rotulo("Ligado há") + ligado]
if e:
    ts = bool(st.get("ip_tailscale"))
    info.append(rotulo("Rede") + f"{sq(e.get('cabo'))} cabo  {sq(e.get('net'))} internet  {sq(ts)} tailscale")
    info.append(rotulo("Casa") + f"https://{st.get('ip_casa', '?')}:9090")
    info.append(rotulo("Fora") + (f"https://{st['ip_tailscale']}:9090" if ts else R + "Tailscale desligado" + N))
    sv = st.get("servicos") or []
    rod = sum(1 for s in sv if s.get("estado") == "running")
    info.append(rotulo("Programas") + f"{sq(sv and rod == len(sv))} {rod} de {len(sv)} rodando")
    lig = sum(1 for f in fl if f.get("ativo"))
    info.append(rotulo("Fluxos") + f"{sq(fl and lig == len(fl))} {lig} ligado(s)" + (f", {R}{len(fl) - lig} desligado(s){N}" if lig < len(fl) else ""))
    inst = wa.get("instancias") or []
    aberto = any(i.get("estado") == "open" for i in inst)
    info.append(rotulo("WhatsApp") + f"{sq(aberto)} " + (f"conectado (+{wa.get('esperado', '')})" if aberto else "DESCONECTADO"))
else:
    info.append(rotulo("Status") + A + "sem dados ainda (rode: sudo servidor tela)" + N)
cor_m = R if livre < 200 else A if livre < 400 else V
cor_t = R if temp >= 75 else A if temp >= 65 else V
info.append(rotulo("Memória") + f"{cor_m}{livre} MB{N} livres de {total} MB")
info.append(rotulo("Cartão") + f"{du.used / 1e9:.1f} de {du.total / 1e9:.1f} GB usados")
info.append(rotulo("Temp") + f"{cor_t}{temp} °C{N}")
if e:
    bk = os.path.basename(st.get("ultimo_backup") or "").replace(".tar.gz", "")
    info.append(rotulo("Backup") + (bk or A + "nenhum ainda" + N))
    if idade_min and idade_min > 10:
        info.append(CI + f"(programas/fluxos lidos há {idade_min} min)" + N)
info += ["", "".join(f"\033[{c}m   " for c in (40, 41, 42, 43, 44, 45, 46, 47)) + N]

cols = shutil.get_terminal_size((80, 24)).columns
if cols >= LARG + 4 + 46:      # logo do lado das informacoes (estilo neofetch)
    topo = max(0, (len(info) - len(logo)) // 2)
    esq = [("", 0)] * topo + list(zip(logo, logo_larg))
    for i in range(max(len(esq), len(info))):
        txt, w = esq[i] if i < len(esq) else ("", 0)
        print("  " + txt + " " * (LARG - w + 4) + (info[i] if i < len(info) else ""))
else:                           # tela estreita: logo em cima
    if cols >= LARG: print("\n".join(logo))
    else: print(f"  {V}{B}TFLEET{N} · {A}{B}SERVIDOR MES{N}")
    print()
    print("\n".join("  " + l for l in info))

if MODO == "tela":              # detalhes so na tela do HDMI / comando "servidor tela"
    ponto = lambda bom: f"{V}[ok]{N}" if bom else f"{R}[!!]{N}"
    nomes = {"n8n": "n8n (fluxos)", "evolution": "Evolution (WhatsApp)", "postgres": "Banco da Evolution", "redis": "Cache da Evolution"}
    print(f"\n  {B}PROGRAMAS{N}")
    for s in st.get("servicos") or [{"nome": "?", "estado": "", "detalhe": "nao consegui ler o Docker"}]:
        print(f"    {ponto(s.get('estado') == 'running')} {nomes.get(s.get('nome'), s.get('nome')):<24} {s.get('detalhe', '')}")
    print(f"\n  {B}FLUXOS{N}")
    for f in fl or [{"nome": "nenhum fluxo (ou n8n desligado)", "ativo": False}]:
        print(f"    {ponto(f.get('ativo'))} {f.get('nome', '')[:52]:<52} {'ligado' if f.get('ativo') else 'DESLIGADO'}")
    inst = wa.get("instancias") or []
    if not inst:
        print(f"\n    {ponto(False)} WhatsApp: nenhum numero conectado (Central > WhatsApp > Abrir tela do QR)")
    print(f"\n  {C}Atualiza a cada 1 minuto. Para entrar e digitar comandos: Alt+F2 (volta aqui com Alt+F1).{N}")
PY
    ;;
  tela-loop)
    root "$@"
    printf '\033[9;0]\033[14;0]'   # nao apagar a tela por inatividade
    COLUMNS=$(stty size 2>/dev/null | awk '{print $2}'); export COLUMNS="${COLUMNS:-100}"
    while true; do t="$("$0" tela 2>&1)"; printf '\033[H\033[2J%s\n' "$t"; sleep 60; done
    ;;
  tela-ligar)
    root "$@"
    cat > /etc/systemd/system/servidor-tela.service <<'UNIT'
[Unit]
Description=Tela de status da Central da Frota no HDMI
After=docker.service network-online.target
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/bin/servidor tela-loop
Environment=LANG=C.UTF-8 PYTHONIOENCODING=utf-8
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
    instalar_boas_vindas
    systemctl daemon-reload
    systemctl disable --now getty@tty1.service >/dev/null 2>&1
    systemctl enable --now getty@tty2.service >/dev/null 2>&1
    systemctl enable --now servidor-tela.service && ok "Tela de status ligada no HDMI. Para login na TV: Alt+F2"
    ;;
  tela-desligar)
    root "$@"
    systemctl disable --now servidor-tela.service >/dev/null 2>&1
    systemctl enable --now getty@tty1.service && ok "Tela HDMI voltou para o login normal"
    ;;
  *)          ajuda ;;
esac
