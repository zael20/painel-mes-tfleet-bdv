{
 "id": "ocorrAvisos00001",
 "name": "Avisos de resolucao no WhatsApp",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "minutes",
       "minutesInterval": 2
      }
     ]
    }
   },
   "name": "A cada 2 minutos",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/avisos_pendentes",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"p_limite\": 1}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Avisos pendentes",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    300
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Um item por aviso. Lista vazia (desligado, fora do expediente, limite por hora) = fluxo para aqui.\nconst r = $input.first().json || {};\nreturn (r.avisos || []).map(a => ({ json: a }));\n"
   },
   "name": "Separar avisos",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__EVOLUTION_URL__/message/sendText/__INSTANCIA__",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ number: $json.grupo_jid, text: $json.texto, delay: 1500, linkPreview: false, quoted: { key: { id: $json.quoted_id, remoteJid: $json.grupo_jid, fromMe: false, participant: $json.autor_jid }, message: { conversation: $json.quoted_texto } } }) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Responder no grupo",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    300
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credEvolution001",
     "name": "Evolution API"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Resposta da Evolution: deu certo se voltou a chave da mensagem enviada.\nconst a = $('Separar avisos').item.json;\nconst r = $json || {};\nconst ok = !!(r.key && r.key.id);\nconst erro = ok ? null : String(r.error?.message || r.message || r.error || JSON.stringify(r)).slice(0, 500);\nreturn { json: { p_id: a.id, p_ok: ok, p_erro: erro } };\n",
    "mode": "runOnceForEachItem"
   },
   "name": "Resultado",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/aviso_marcar",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Marcar avisada",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    300
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/perguntas_carro_pendentes",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"p_limite\": 1}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Perguntas pendentes",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    520
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Um item por pergunta \"qual o numero do carro?\". Lista vazia (desligado, limite por hora) = para aqui.\nconst r = $input.first().json || {};\nreturn (r.perguntas || []).map(a => ({ json: a }));\n"
   },
   "name": "Separar perguntas",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    520
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__EVOLUTION_URL__/message/sendText/__INSTANCIA__",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ number: $json.grupo_jid, text: $json.texto, delay: 1500, linkPreview: false, quoted: { key: { id: $json.quoted_id, remoteJid: $json.grupo_jid, fromMe: false, participant: $json.autor_jid }, message: { conversation: $json.quoted_texto } } }) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Perguntar no grupo",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    520
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credEvolution001",
     "name": "Evolution API"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Guarda o id da pergunta enviada: a resposta \"Carro 84\" citando ela vai para a ocorrencia certa.\nconst a = $('Separar perguntas').item.json;\nconst r = $json || {};\nconst ok = !!(r.key && r.key.id);\nconst erro = ok ? null : String(r.error?.message || r.message || r.error || JSON.stringify(r)).slice(0, 500);\nreturn { json: { p_id: a.id, p_ok: ok, p_erro: erro, p_msg_id: ok ? r.key.id : null } };\n",
    "mode": "runOnceForEachItem"
   },
   "name": "Resultado pergunta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    520
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/pergunta_marcar",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Marcar perguntada",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    520
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/procedimentos_pendentes",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"p_limite\": 1}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Procedimentos pendentes",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    740
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Um envio por relato: com video (sendMedia, texto vai na legenda) ou so texto (sendText).\nconst r = $input.first().json || {};\nreturn (r.procedimentos || []).map(a => {\n  const quoted = { key: { id: a.quoted_id, remoteJid: a.grupo_jid, fromMe: false, participant: a.autor_jid },\n                   message: { conversation: a.quoted_texto } };\n  const corpo = a.video_url\n    ? { number: a.grupo_jid, mediatype: 'video', mimetype: 'video/mp4', media: a.video_url, fileName: 'passo-a-passo.mp4',\n        caption: a.texto, delay: 1500, quoted }\n    : { number: a.grupo_jid, text: a.texto, delay: 1500, linkPreview: false, quoted };\n  return { json: { id: a.id, endpoint: a.video_url ? 'sendMedia' : 'sendText', corpo } };\n});\n"
   },
   "name": "Montar procedimento",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    740
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=__EVOLUTION_URL__/message/{{ $json.endpoint }}/__INSTANCIA__",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.corpo) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Mandar passo a passo",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    740
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credEvolution001",
     "name": "Evolution API"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Guarda o id da mensagem do passo a passo: a resposta \"deu certo\"/\"nao deu\" citando ela vai para a ocorrencia certa.\nconst a = $('Montar procedimento').item.json;\nconst r = $json || {};\nconst ok = !!(r.key && r.key.id);\nconst erro = ok ? null : String(r.error?.message || r.message || r.error || JSON.stringify(r)).slice(0, 500);\nreturn { json: { p_id: a.id, p_ok: ok, p_erro: erro, p_msg_id: ok ? r.key.id : null } };\n",
    "mode": "runOnceForEachItem"
   },
   "name": "Resultado procedimento",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    740
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "__SUPABASE_URL__/rest/v1/rpc/procedimento_marcar",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {
     "timeout": 30000
    }
   },
   "name": "Marcar procedimento",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    740
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "credSupabase0001",
     "name": "Supabase (chave secreta)"
    }
   }
  }
 ],
